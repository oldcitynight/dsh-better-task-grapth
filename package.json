{
  "name": "dsh-better-task-grapth",
  "version": "0.3.3-rc.1",
  "workflowCompatibilityEpoch": 1,
  "os": [
    "linux"
  ],
  "description": "Transactional task graphs with a conversation panel for DeepSeek Harness",
  "license": "GPL-3.0-only",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "task-graph"
  ],
  "homepage": "https://github.com/oldcitynight/dsh-better-task-grapth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldcitynight/dsh-better-task-grapth.git"
  },
  "bugs": {
    "url": "https://github.com/oldcitynight/dsh-better-task-grapth/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "bin": {
    "dsh-workflow-script-archive": "./scripts/workflow-script-archive.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./core": "./core.mjs",
    "./store": "./store.mjs",
    "./host": "./host.mjs",
    "./interop": "./interop.mjs",
    "./client": "./client.js",
    "./extensions": "./extensions.mjs",
    "./validation": "./validation.mjs",
    "./hierarchy": "./hierarchy.mjs",
    "./rules": "./rules.mjs",
    "./settings-form": "./settings-form.mjs",
    "./workflow-limits": "./workflow-limits.mjs",
    "./workflow-compatibility": "./workflow-compatibility.mjs",
    "./workflow-sdk": {
      "types": "./workflow-sdk.d.ts",
      "default": "./workflow-sdk.mjs"
    }
  },
  "files": [
    "client.js",
    "client.source.mjs",
    "settings-form.mjs",
    "cordis.patch.yml",
    "core.mjs",
    "host.mjs",
    "index.mjs",
    "interop.mjs",
    "journal.mjs",
    "projection.mjs",
    "remote.mjs",
    "scripts/build-client.mjs",
    "scripts/client-module.mjs",
    "store.mjs",
    "tools.mjs",
    "tool-display.mjs",
    "unit-order.mjs",
    "view-model.mjs",
    "work-policy.mjs",
    "extensions.mjs",
    "commands.mjs",
    "VALIDATION.md",
    "DSH-COMPATIBILITY.json",
    "validation.mjs",
    "scripts/release-docs.mjs",
    "hierarchy.mjs",
    "rules.mjs",
    "workflow-limits.json",
    "workflow-limits.mjs",
    "workflow-compatibility.mjs",
    "docs/UNIT_WORKFLOW_20261123.html",
    "workflow-sdk.mjs",
    "workflow-script.mjs",
    "workflow-sdk.d.ts",
    "scripts/workflow-script-archive.mjs"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.5 || 0.2.2-rc.4 || 0.2.2-rc.3 || 0.2.2-rc.2"
  },
  "scripts": {
    "build": "npm run docs:check && node scripts/build-client.mjs",
    "check": "node scripts/build-client.mjs --check",
    "test": "npm run docs:check && npm run check && node --test",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "pack:bundle": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && npm pack --pack-destination dist",
    "docs:sync": "node scripts/release-docs.mjs --write",
    "docs:check": "node scripts/release-docs.mjs --check"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "semver": "7.8.6",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5 || 0.2.2-rc.4 || 0.2.2-rc.3 || 0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5 || 0.2.2-rc.4 || 0.2.2-rc.3 || 0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5 || 0.2.2-rc.4 || 0.2.2-rc.3 || 0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5 || 0.2.2-rc.4 || 0.2.2-rc.3 || 0.2.2-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
